// Minimal eclipse/zenoh 1.9 router config for the --fabric demo path.
//
// Plaintext tcp/7447 (a LOCAL loopback demo — NOT how the production fabric runs,
// which is mTLS with a per-identity ACL). One in-memory storage on keys/** so a
// late reader's get() returns the retained key bundle, mirroring the production
// keys/** retention store. Deliberately open: the point here is the transport, not
// the router ACL (the crypto is what enforces the read cut in this repo).
{
  mode: "router",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: false } },
  // The storage manager ships as a plugin library in the eclipse/zenoh image; without
  // plugins_loading the router never declares the keys/** storage and a late get() is empty.
  plugins_loading: { enabled: true, search_dirs: ["/", "/opt/zenoh/plugins"] },
  plugins: {
    storage_manager: {
      storages: {
        keys: {
          key_expr: "keys/**",
          volume: "memory",
        },
      },
    },
  },
}
